{
  "version": 2,
  "framework": null,
  "buildCommand": "cd backend && npm install",
  "installCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/**"]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|svg|ico))",
      "dest": "frontend/$1"
    },
    {
      "src": "/vendor-login.html",
      "dest": "frontend/vendor-login.html"
    },
    {
      "src": "/vendor-signup.html",
      "dest": "frontend/vendor-signup.html"
    },
    {
      "src": "/vendor-admin.html",
      "dest": "frontend/vendor-admin.html"
    },
    {
      "src": "/styles.css",
      "dest": "frontend/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "frontend/app.js"
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
